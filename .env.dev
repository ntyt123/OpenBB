# ----------------- 可选API密钥 -----------------
# Benzinga新闻API
BENZINGA_API_KEY=your_benzinga_key_here

# NASDAQ Data Link (Quandl) API
NASDAQ_API_KEY=your_nasdaq_quandl_key_here

# Intrinio金融数据API
INTRINIO_API_KEY=your_intrinio_key_here

# Tiingo金融数据API
TIINGO_TOKEN=your_tiingo_token_here

# Trading Economics API
TRADINGECONOMICS_API_KEY=your_trading_economics_key_here

# Tradier券商API
TRADIER_API_KEY=your_tradier_key_here
TRADIER_ACCOUNT_TYPE=sandbox

# BizToc商业新闻API
BIZTOC_API_KEY=your_biztoc_key_here

# ----------------- 应用配置 -----------------
# 应用日志级别
OPENBB_LOG_LEVEL=INFO

# 开发模式开关
OPENBB_DEV_MODE=true

# 调试模式开关
OPENBB_DEBUG=true

# Python路径
PYTHONPATH=/app

# 应用密钥（用于会话加密）
SECRET_KEY=your_very_long_random_secret_key_for_session_encryption_12345

# 允许的主机名
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ----------------- 网络代理配置（如果需要）-----------------
# HTTP代理
# HTTP_PROXY=http://proxy.company.com:8080

# HTTPS代理
# HTTPS_PROXY=https://proxy.company.com:8080

# 不使用代理的地址
# NO_PROXY=localhost,127.0.0.1,postgres,redis

# ----------------- 性能配置 -----------------
# 最大工作进程数
MAX_WORKERS=4

# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# 数据缓存过期时间（秒）
CACHE_EXPIRE_TIME=3600

# ----------------- 安全配置 -----------------
# 启用HTTPS重定向
FORCE_HTTPS=false

# 启用安全头
ENABLE_SECURITY_HEADERS=true

# CORS允许的源
CORS_ORIGINS=http://localhost:3000,http://localhost:8088

# ----------------- 其他配置 -----------------
# 时区设置
TZ=UTC

# 默认货币
DEFAULT_CURRENCY=USD

# 数据更新频率（分钟）
DATA_UPDATE_INTERVAL=60